{
  "name": "moqi",
  "version": "0.4.3",
  "description": "墨启 MOQI - 轻量智能笔记、AI 辅助与远程运维工作台",
  "main": "app-build/main/index.js",
  "author": "biji",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "clean": "node -e \"require('fs').rmSync('app-build',{recursive:true,force:true})\"",
    "build": "npm run clean && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "smoke:collab": "node scripts/collab-smoke.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "start:legacy": "electron main.js"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@blocknote/core": "latest",
    "@blocknote/mantine": "latest",
    "@blocknote/react": "latest",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.1",
    "@hocuspocus/provider": "^2.15.3",
    "@types/node": "^20.16.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "com.biji.knowledge",
    "productName": "墨启 MOQI",
    "compression": "normal",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@serialport/bindings-cpp/prebuilds/**/*"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "app-build/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      "ssh_agent.py"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "墨启 MOQI",
      "artifactName": "MOQI-${version}-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "MOQI-${version}-${arch}-Portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xiaofan02",
        "repo": "biji"
      }
    ]
  }
}
