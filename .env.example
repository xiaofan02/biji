# 复制为 .env 后按需修改:cp .env.example .env

# ===== 数据库 =====
POSTGRES_USER=biji
POSTGRES_PASSWORD=请改成强密码
POSTGRES_DB=biji

# ===== 鉴权 =====
# 务必改成一段长随机串,例如:openssl rand -hex 32
# 更换它会让所有已登录用户失效、需重新登录。
JWT_SECRET=请改成长随机串
# 登录令牌有效期(如 30d / 12h)
TOKEN_TTL=30d

# 是否允许客户端注册新账号。公网部署请务必同时设置一个足够长的邀请码。
REGISTRATION_ENABLED=false
REGISTRATION_CODE=请换成一个足够长且随机的邀请码

# ===== 站点 / HTTPS =====
# 你的域名(A 记录指向公网 IP)。Caddy 据此自动签发并续期 HTTPS 证书。
# 没有域名、仅用 IP:把 DOMAIN 留空,并改用 Caddyfile 里的「自签」段。
DOMAIN=biji.example.com
# 文档内图片的绝对地址前缀,一般 = https://你的域名。留空则用相对路径。
PUBLIC_URL=https://biji.example.com

# ===== 版本快照(可选,留空用默认)=====
# 同一文档两次快照的最小间隔(毫秒),默认 300000(5 分钟)
# SNAPSHOT_MIN_INTERVAL_MS=300000
# 每篇文档保留多少份历史快照,默认 50
# SNAPSHOT_KEEP=50
